<!-- Кастомные правила стенда SIEM+LLM (stage-23, docs/E2E_SCENARIOS.md).
     Монтируется поверх /var/ossec/etc/rules/local_rules.xml (в дефолтном
     файле только сэмпл 100001 — перезапись безопасна).

     КРИТИЧНО для нормализации SIEM (app/services/normalization.py):
     event_type = rule.groups[0] — ПЕРВАЯ группа правила должна быть
     семантической (authentication_failed / web_attack / privilege_escalation).
     Порядок групп в алерте = порядок в строке group: по исходникам Wazuh 4.7
     (src/analysisd/rules.c:417,573) группа правила начинается с КОРНЕВОГО
     <group name="..."> элемента файла, rule-level <group> дописывается после.
     Поэтому у файла НЕСКОЛЬКО корневых <group> (парсер это разрешает:
     rules.c:280-320), и семантическое имя стоит в каждом первым.

     Правило 100100 — дочернее (if_sid) к built-in sshd-правилам 5710/5711/5716
     (см. ruleset/rules/0095-sshd_rules.xml, у них группы начинаются с
     syslog,sshd — поэтому built-in алерты для нормализации непригодны).
     100101 — fallback на текст лога, если sshd-декодер не отработал.
-->

<group name="authentication_failed,sshd,stand,">

  <!-- С1 «Подбор пароля по SSH»: неудачная аутентификация sshd.
       Уровень 7 — перекрывает родительские 5710/5716 (level 5). -->
  <rule id="100100" level="7">
    <if_sid>5710,5711,5716</if_sid>
    <description>sshd: неудачная попытка аутентификации (стенд).</description>
  </rule>

  <!-- Fallback: тот же класс события по тексту лога (если sshd-декодер не
       отработал и if_sid не сработал). Уровень 6 — ниже 100100, чтобы при
       одновременном совпадении выбиралось дочернее правило. -->
  <rule id="100101" level="6">
    <regex>Failed password for|Invalid user|illegal user|maximum authentication attempts exceeded</regex>
    <description>sshd: неудачная попытка аутентификации (fallback по тексту лога).</description>
  </rule>

</group>

<group name="web_attack,nginx,stand,">

  <!-- С2 «SQL-инъекция на веб-сервис»: маркеры SQLi в строке запроса
       (access.log). Ловит и сырые %27/%20, и декодированные кавычки/пробелы.
       Уровень 10 — чтобы перекрывать built-in web-правила (404/сканеры),
       которые совпадают на тех же строках. -->
  <rule id="100200" level="10">
    <regex type="pcre2">(?i)(%27|')(%20|\s|\+)*(or|and|union|select)\b|union(%20|\s|%2B|\+)+select|sleep\(|information_schema</regex>
    <description>nginx: SQL-инъекция в параметрах запроса (стенд).</description>
  </rule>

</group>

<group name="privilege_escalation,accounts,stand,">

  <!-- С3 «Инсайдер: бэкдор-аккаунт»: создание/изменение учётных записей и
       правки sudoers на сервере. Совпадает и по строкам useradd/usermod
       из auth.log, и по строке sudo с COMMAND=useradd/usermod. -->
  <rule id="100300" level="8">
    <regex>useradd|adduser|usermod|/etc/sudoers</regex>
    <description>Изменение учётных записей: возможное повышение привилегий (стенд).</description>
  </rule>

</group>
