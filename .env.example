# DATABASE_URL нужен только для запуска БД вне Docker (внутри стенда compose задаёт свой); остальные переменные подхватываются docker-compose.yml
DATABASE_URL=postgresql+psycopg://siem:siem@localhost:5433/siem
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# производительность инференса (stage-18): окно контекста (дефолт Ollama 2048
# меньше промпта с ECS-JSON), потолок генерации, удержание модели в памяти
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_KEEP_ALIVE=30m
# низкая температура — детерминированный JSON-анализ без дрейфа (stage-24)
OLLAMA_TEMPERATURE=0.2
CORRELATION_WINDOW_MINUTES=5
AUTO_ANALYSIS=true
AUTO_ANALYSIS_LEVELS=low
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=480
AUTO_CLOSE_LEVELS=low
# stage-23: реальные реакции playbook через Wazuh Manager API —
# PUT /active-response доставляет AR-команду (block-ip/lock-account/
# isolate-host) wazuh-агенту на ВМ актива (docs/E2E_STAND.md).
# Учётка API менеджера: wazuh/wazuh — дефолт стенда (read-only роль
# включает active-response:run); для окружения вне учебного стенда сменить
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh
# self-signed сертификат менеджера — проверка TLS выключена на стенде
WAZUH_API_VERIFY_TLS=false
WAZUH_API_TIMEOUT_SECONDS=15
