# DATABASE_URL нужен только для запуска БД вне Docker (внутри стенда compose задаёт свой); остальные переменные подхватываются docker-compose.yml
DATABASE_URL=postgresql+psycopg://siem:siem@localhost:5433/siem
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# производительность инференса (stage-18): окно контекста (дефолт Ollama 2048
# меньше промпта с ECS-JSON), потолок генерации, удержание модели в памяти
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_KEEP_ALIVE=30m
CORRELATION_WINDOW_MINUTES=5
AUTO_RESPONSE=false
AUTO_ANALYSIS=true
AUTO_ANALYSIS_LEVELS=low
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=480
AUTO_CLOSE_LEVELS=low
# stage-20: реальное исполнение playbook (docs/REAL_EXECUTION.md) — реестр
# агентов на ВМ наблюдаемых пользователей: "имя=URL|токен" (разделитель url/
# токена «|», т.к. URL содержит «://» и порт; имя цели = имя актива).
# В compose задаётся по умолчанию для трёх агентов-«ВМ»
EXECUTION_TARGETS=
EXECUTION_TIMEOUT_SECONDS=10
# режим исполнения по умолчанию: simulation (dry run) | real (на ВМ)
EXECUTION_DEFAULT_MODE=simulation
# токен агентов-«ВМ» стенда (AGENT_TOKEN в compose тоже берётся отсюда)
AGENT_TOKEN=dev-agent-token
